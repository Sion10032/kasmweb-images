<?xml version="1.0" encoding="UTF-8"?>
<!-- 微信右键菜单 -->
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="WeChat">
    <item label="WeChat">
      <action name="Execute">
        <execute>/usr/local/bin/wechat --no-sandbox</execute>
      </action>
    </item>
    <item label="Terminal">
      <action name="Execute">
        <execute>xterm</execute>
      </action>
    </item>
    <separator />
    <item label="Reload Openbox">
      <action name="Reconfigure" />
    </item>
    <item label="Restart Openbox">
      <action name="Restart" />
    </item>
    <separator />
    <item label="Exit">
      <action name="Exit" />
    </item>
  </menu>
</openbox_menu>
