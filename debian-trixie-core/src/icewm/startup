#!/bin/sh
# IceWM 自启脚本：icewm-session 启动时 exec 执行（须可执行 + shebang 正确）
# 任务栏 / 系统托盘 / 时钟 / 开始菜单由 icewm 内置承担，无需 tint2

# 关闭屏保与 DPMS
xset s off 2>/dev/null
xset -dpms 2>/dev/null

# 应用自启钩子：应用镜像提供 /dockerstartup/app_autostart.sh
# 若存在则启动应用，否则启动一个 terminal 作为占位
if [ -x /dockerstartup/app_autostart.sh ]; then
    /dockerstartup/app_autostart.sh &
fi

# 监听屏幕分辨率变化（KasmVNC Remote Resizing），对所有窗口 moveby 触发重新适配
(
    last=""
    while true; do
        cur=$(xrandr --current 2>/dev/null | sed -nr 's/.*current ([0-9]+) x ([0-9]+).*/\1x\2/p' | head -1)
        if [ -n "$cur" ] && [ "$cur" != "$last" ]; then
            [ -n "$last" ] && pgrep -x icewm >/dev/null && icesh -a moveby 0 0 2>/dev/null
            last="$cur"
        fi
        sleep 0.5
    done
) &
